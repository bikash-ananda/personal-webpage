# Copy to .env.local for local development. Never commit real values.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://personal_os_app:replace-me@127.0.0.1:5432/personal_os
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
EMAIL_FROM="Bikash OS <no-reply@example.com>"

# Free-first AI routing. Local Ollama does not require an API key.
AI_PROVIDER_ORDER=ollama,gemini,groq,openrouter,cloudflare,nvidia
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
# External providers are blocked until you explicitly opt in.
AI_ALLOW_EXTERNAL_PROVIDERS=false
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CLOUDFLARE_BASE_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=


# Copy to .env.local for local development. Never commit real values.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://personal_os_app:replace-me@127.0.0.1:5432/personal_os
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
EMAIL_FROM="Bikash OS <no-reply@example.com>"

# Optional AI planner. Use a hosted or OpenAI-compatible local model endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-provider-key
AI_MODEL=replace-with-model-name
